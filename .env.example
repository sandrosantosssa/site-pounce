# =============================================================
# Site Pounce — variáveis de ambiente
# =============================================================

# ---- FRONTEND (Vite) — leitura pública de eventos/conteúdo no Supabase ----
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# ---- SERVIDOR (Vercel Functions — api/notify, api/contact) ----
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Settings → API → Secret keys → sb_secret_... (ignora RLS, só no servidor)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Resend (envio dos e-mails de lead/contato)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=Pounce <contato@pounce.com.br>
# Para qual e-mail os leads/contatos são enviados
CONTACT_TO=comercial@pounce.com.br
